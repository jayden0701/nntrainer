<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The AAR deliberately declares no storage permission. Applications choose
      their own model-storage policy and should use app-owned storage or the
      Storage Access Framework instead of inheriting broad filesystem access
      from a library manifest.
    -->

    <application>
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
    </application>

</manifest>
